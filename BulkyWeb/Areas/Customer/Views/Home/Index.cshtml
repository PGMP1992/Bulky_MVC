@model IEnumerable<Product>

@if (ViewBag.Message != "")
{
    <div class="col-12 p-3 mb-2">
        <span class="text-danger"><b>@ViewBag.Message</b></span>
    </div>
}

<div class="row row-cols-2 row-cols-sm-2 row-cols-md-5 row-cols-lg-5 g-2">
    @foreach( var product in Model)
    {
        <div class="col">
            <div class="card h-100">
                <div class="card-header h-100 border-0">
                    @if( product.ProductImages != null && product.ProductImages.Count > 0)
                    {
                    <img src="@product.ProductImages.FirstOrDefault().ImageUrl" class="card-img-top rounded" style="max-height: 200px; object-fit: cover;" />
                    }
                    else
                    {
                    <img src="https://placehold.co/500x600/png" class="card-img-top rounded" style="max-height: 200px; object-fit: cover;" />
                    }
                    @* <img src="@product.ImageUrl" class="card-img-top rounded" /> *@
                </div>
                <div class="card-body pb-0">
                    <h6 class="text-dark text-center">@product.Title</h6>
                    <h6 class="text-warning text-center"> by <b>@product.Author</b></h6>
                    <h6 class="text-dark opacity-75 text-center mb-0">
                        List Price: <span class="text-decoration-line-through">@product.ListPrice.ToString("c")</span>
                    </h6>
                            
                    <h6 class="text-dark opacity-75 text-center">
                        As low as: <span>@product.Price100.ToString("c")</span>
                    </h6>
                </div>
                <div class="card-footer border-0 ">
                    @* has to pass route below to Controller.Details *@
                    <a asp-action="Details" 
                        asp-route-productId="@product.Id" 
                            class="btn btn-dark border-0">Details
                    </a>
                </div>
                </div>
            </div>
    }
</div>

@* Hover effect styling for interactivity *@
<style>

    .card:hover {
        border: 1px solid white;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        /* transform: scale(1.03);
            transition: all 0.3s ease; */
        background-image: linear-gradient(to right, rgba(243, 232, 232, 0.918), rgba(255, 0, 0, 0));
        img {
            transform: scale(1.03);
            transition: all 0.3s ease;
        }
    }

</style>
