@model IEnumerable<Product>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-5 row-cols-lg-5 g-2">
    @foreach( var product in Model)
    {
        <div class="col">
            <div class="card h-100">
                    <div class="card border-0 h-100">
                        <div class="card-header h-100 border-0">
                            @if( product.ProductImages != null && product.ProductImages.Count > 0)
                            {
                                <img src="@product.ProductImages.FirstOrDefault().ImageUrl" class="card-img-top rounded" />
                            }
                            else
                            {
                                <img src="https://placehold.co/500x600/png" class="card-img-top rounded" />
                            }
                            @* <img src="@product.ImageUrl" class="card-img-top rounded" /> *@
                        </div>
                        <div class="card-body pb-0">
                            <h6 class="text-dark text-center">@product.Title</h6>
                            <h6 class="text-warning text-center"> by <b>@product.Author</b></h6>
                            <h6 class="text-dark opacity-75 text-center mb-0">
                                List Price: <span class="text-decoration-line-through">@product.ListPrice.ToString("c")</span>
                            </h6>
                            
                            <h6 class="text-dark opacity-75 text-center">
                                As low as: <span>@product.Price100.ToString("c")</span>
                            </h6>
                        </div>
                    </div>
                    <div>
                        <div class="card-footer border-0 ">
                            @* has to pass route below to Controller.Details *@
                            <a asp-action="Details" 
                                asp-route-productId="@product.Id" 
                                    class="btn btn-primary border-0 form-control">Details
                            </a>
                        </div>
                    </div>
                </div>
            </div>
    }
</div>